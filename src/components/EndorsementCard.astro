---
interface Props {
  href: string;
  logoSrc: string;
  alt: string;
  label: string;
}

const { href, logoSrc, alt, label } = Astro.props as Props;
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  class="group hover:border-primary hover:bg-primary/90 relative rounded-lg border-2 border-white/40 bg-white/70 p-6 shadow transition-all duration-300"
>
  <div class="bg-primary/10 absolute inset-0 rounded-lg opacity-0 transition-opacity group-hover:opacity-100"></div>
  <div class="relative">
    <img src={logoSrc} {alt} class="h-16 w-auto object-contain transition-all duration-300 md:h-20" />
  </div>
  <span
    class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-xs whitespace-nowrap text-white/50 opacity-0 transition-opacity group-hover:opacity-100"
  >
    {label}
  </span>
</a>
