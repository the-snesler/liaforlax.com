---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import headshot from '../assets/headshot.jpg';
import EndorsementCard from './EndorsementCard.astro';
import PriorityCard from './PriorityCard.astro';
---

<main class="bg-background">
  <section class="relative flex min-h-screen items-center overflow-hidden pt-32">
    <div class="bg-background absolute inset-0"></div>
    <div class="hero-map-overlay pointer-events-none absolute inset-0"></div>
    <div class="bg-secondary absolute top-1/4 -left-20 h-96 w-96 animate-pulse rounded-full opacity-50 mix-blend-multiply blur-3xl filter"></div>
    <div class="bg-primary absolute right-0 bottom-0 h-[500px] w-[500px] rounded-full opacity-20 mix-blend-overlay blur-[100px] filter"></div>
    <div class="relative z-10 mx-auto grid w-full max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="relative space-y-8 lg:col-span-7">
        <div
          class="bg-secondary border-primary text-primary font-display inline-block -rotate-2 transform border-2 px-6 py-2 font-black tracking-widest uppercase shadow-[4px_4px_0px_0px_rgba(236,171,58,0.5)]"
        >
          Vote April 7
        </div>
        <h1 class="font-display text-6xl leading-[0.85] font-black tracking-tighter sm:text-7xl md:text-8xl">
          <span class="block text-white">READY</span>
          <span class="text-primary ml-8 block sm:ml-16">TO LEAD</span>
          <span class="text-outline-primary ml-4 block text-transparent opacity-70 sm:ml-8">DISTRICT 17</span>
        </h1>
        <p class="border-primary max-w-lg border-l-4 py-2 pl-6 text-xl font-light text-white/90 md:text-2xl">
          Bringing <span class="text-primary font-bold">new energy</span>, accessible transit, and real housing solutions to La Crosse County.
        </p>
        <div class="flex flex-col gap-6 pt-4 sm:flex-row">
          <a
            class="group bg-primary text-background font-display relative inline-flex items-center justify-center gap-2 overflow-hidden px-8 py-4 text-lg font-black tracking-wider uppercase"
            href="#join"
          >
            <span class="relative z-10 flex items-center gap-2">Join The Campaign <Icon name="lucide:arrow-right" class="font-bold" /></span>
            <div class="absolute inset-0 translate-y-full transform bg-white transition-transform duration-300 ease-in-out group-hover:translate-y-0">
            </div>
          </a>
        </div>
      </div>
      <div class="relative mt-12 flex justify-center lg:col-span-5 lg:mt-0 lg:justify-end">
        <div class="relative aspect-3/4 w-72 sm:w-[420px]">
          <div class="border-primary absolute top-4 -right-4 z-0 h-full w-full border-4 bg-transparent"></div>
          <div class="bg-secondary absolute -top-4 -left-4 z-0 h-full w-full"></div>
          <div class="absolute inset-0 z-10 overflow-hidden bg-gray-300 shadow-2xl transition-all duration-500">
            <Image src={headshot} alt="Lia Manock smiling" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-secondary relative py-20" id="about">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="font-display text-5xl leading-none font-black tracking-tighter text-white uppercase md:text-7xl">
          About <span class="text-outline-primary block text-transparent md:inline">Lia</span>
        </h2>
      </div>
      <div class="mx-auto max-w-3xl">
        <p class="border-primary border-l-4 pl-6 text-lg leading-relaxed font-light text-white/90 md:text-xl">
          As a lifelong La Crosse County resident, daughter of local business owners, and student at Western Technical College I am deeply connected
          to this community and passionate about the role local governance can play in bettering our county for all residents. My passion for helping
          others is the driving force behind everything that I do and why I'm running for La Crosse County Board. I am currently sitting on the YWCA
          Board of Directors, filming a documentary about local housing issues, and pursuing a career in social work. I will carry all these
          experiences with me if elected to La Crosse County Board and focus on the services our county can provide above all else.
        </p>
      </div>
    </div>
  </section>
  <section class="bg-background relative py-16" id="issues">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="font-display text-5xl leading-none font-black tracking-tighter text-white uppercase md:text-7xl">
          Our <span class="text-outline-primary block text-transparent md:inline">Priorities</span>
        </h2>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <PriorityCard
          icon="lucide:bus"
          title="Transportation That Works"
          description="Prioritizing accessible, reliable transit for District 17 to ensure everyone can get to work, school, and essential services."
        />
        <PriorityCard
          icon="lucide:home"
          title="Fair Housing For All"
          description="Fighting to protect renters and first-time home buyers. We need affordable options for working families."
          class="mt-8 md:mt-0"
        />
        <PriorityCard
          icon="lucide:user"
          title="Dignity for Older Adults"
          description="Supporting aging in place with enhanced healthcare access and home accessibility modifications."
          class="mt-8 md:mt-0 lg:mt-0"
        />
        <PriorityCard
          icon="lucide:shield-check"
          title="Safety for Our Community"
          description="Preventing all county collaboration with ICE to ensure public trust in county law enforcement and the continued safety of all residents."
          class="mt-8 md:mt-0 lg:mt-0"
        />
        <PriorityCard
          icon="lucide:sun"
          title="Affordable Clean Energy"
          description="Preparing La Crosse County for the future through long term sustainability efforts to reduce utility costs for the county and its residents."
          class="mt-8 md:mt-0 lg:mt-0"
        />
        <PriorityCard
          icon="lucide:store"
          title="Support for Small Businesses"
          description="Supporting small businesses, especially those just starting out, by providing public grants and other resources so that more of our money stays within our community."
          class="mt-8 md:mt-0 lg:mt-0"
        />
      </div>
    </div>
  </section>
  <section class="bg-background relative py-20" id="endorsements">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 text-center">
        <h2 class="font-display text-5xl leading-none font-black tracking-tighter text-white uppercase md:text-7xl">
          <span class="text-outline-primary block text-transparent md:inline">Endorsed</span> By
        </h2>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        <EndorsementCard
          href="https://www.citizenactionwi.org/2026/02/27/2026-spring-endorsements/#:~:text=Lia%20Manock%20%E2%80%93%20La%20Crosse%20County%20Board%20District%2017"
          logoSrc="/CAW_Logo_Transparent_Background.webp"
          alt="Citizen Action of Wisconsin"
          label="Citizen Action of Wisconsin"
        />
        <EndorsementCard
          href="https://www.facebook.com/share/p/1DsTLwEbxt/"
          logoSrc="home_logo.png"
          alt="Hmong Organizing & Mobilizing for Empowerment"
          label="Hmong Organizing & Mobilizing for Empowerment"
        />
        <EndorsementCard
          href="https://www.facebook.com/share/p/1UodY6qGyg/"
          logoSrc="/lax-dems-logo.png"
          alt="LAX Dems - La Crosse County Democratic Party"
          label="LAX Dems"
        />
        <EndorsementCard
          href="https://wisaflcio.org/candidate-endorsements"
          logoSrc="/wiaflcio_logo.webp"
          alt="Western Wisconsin AFL-CIO"
          label="Western Wisconsin AFL-CIO"
        />
        <EndorsementCard
          href="https://www.wisconsinprogress.org/"
          logoSrc="/wisconsin-progress-logo.png"
          alt="Wisconsin Progress"
          label="Wisconsin Progress"
        />
      </div>
    </div>
  </section>
  <section class="relative overflow-hidden py-20" id="join">
    <div class="bg-secondary absolute inset-0 z-0 scale-110 -skew-y-6 transform"></div>
    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="bg-primary border-background border-4 p-8 shadow-[12px_12px_0px_0px_rgba(32,59,113,0.5)] md:p-12">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div>
            <h2 class="font-display text-background mb-4 text-4xl leading-none font-black uppercase md:text-6xl">
              Join The<br />Movement
            </h2>
            <p class="text-background mb-0 text-lg font-bold">
              Stay updated on campaign events, volunteer opportunities, and news. Let's build a better county together.
            </p>
          </div>
          <form id="signup-form" class="space-y-4">
            <div>
              <label class="sr-only" for="name">Full Name</label>
              <input
                class="border-background text-background placeholder-background/70 focus:border-background w-full border-2 bg-white/20 px-4 py-3 font-bold transition-colors focus:bg-white focus:ring-0"
                id="name"
                name="name"
                placeholder="FULL NAME"
                type="text"
              />
            </div>
            <div>
              <label class="sr-only" for="email">Email Address</label>
              <input
                class="border-background text-background placeholder-background/70 focus:border-background w-full border-2 bg-white/20 px-4 py-3 font-bold transition-colors focus:bg-white focus:ring-0"
                id="email"
                name="email"
                placeholder="EMAIL ADDRESS"
                type="email"
                required
              />
            </div>
            <div id="form-status" class="hidden py-2 text-center font-bold"></div>
            <button
              class="bg-background hover:bg-secondary font-display w-full px-8 py-4 font-black tracking-widest text-white uppercase shadow-lg transition-all disabled:cursor-not-allowed disabled:opacity-50"
              type="submit"
              id="submit-btn"
            >
              <span id="btn-text">Count Me In</span>
              <span id="btn-loading" class="hidden">Joining...</span>
            </button>
            <p class="text-background/60 text-center text-xs font-bold">We respect your privacy. Unsubscribe at any time.</p>
          </form>

          <script>
            import { actions } from 'astro:actions';

            const form = document.getElementById('signup-form') as HTMLFormElement;
            const status = document.getElementById('form-status')!;
            const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
            const btnText = document.getElementById('btn-text')!;
            const btnLoading = document.getElementById('btn-loading')!;

            form.addEventListener('submit', async e => {
              e.preventDefault();

              submitBtn.disabled = true;
              btnText.classList.add('hidden');
              btnLoading.classList.remove('hidden');
              status.classList.add('hidden');

              const formData = new FormData(form);
              const data = {
                name: formData.get('name') as string,
                email: formData.get('email') as string
              };

              try {
                await actions.subscribe.orThrow(data);
                status.textContent = "You're in! We'll be in touch soon.";
                status.className = 'text-center font-bold py-2 text-background';
                form.reset();
              } catch (error) {
                status.textContent = error instanceof Error ? error.message : 'Please try again later.';
                status.className = 'text-center font-bold py-2 text-red-800';
              } finally {
                submitBtn.disabled = false;
                btnText.classList.remove('hidden');
                btnLoading.classList.add('hidden');
                status.classList.remove('hidden');
              }
            });
          </script>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-background relative py-12" id="footer">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-light text-white/70">Paid for by Lia Manock for County Board. All rights reserved.</p>
    </div>
  </section>
</main>

<style>
  .text-outline-primary {
    -webkit-text-stroke: 2.5px var(--color-primary);
  }
  .font-black {
    letter-spacing: 0.1rem;
  }
  section[id] {
    scroll-margin-top: 6rem;
  }
</style>
